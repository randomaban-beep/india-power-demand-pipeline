# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Optional: data.gov.in API key (for CEA monthly state-wise data)
DATA_GOV_IN_API_KEY=

# Optional: override DB path (default: data/energy.db)
ENERGY_DB_PATH=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
